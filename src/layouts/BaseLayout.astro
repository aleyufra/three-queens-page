---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import logo from '../assets/logo.jpg';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Foto para la vista previa al compartir el link (por defecto, el logo) */
  imagen?: ImageMetadata;
  imagenAlt?: string;
  tipo?: 'website' | 'product';
  /** Con tipo "product": precio en pesos para las etiquetas product:price */
  precio?: number;
  /** Para páginas que no tienen que aparecer en buscadores (/panel, productos ocultos) */
  noindex?: boolean;
}

const {
  title = `${site.nombre} | Calzado en Palpalá, Jujuy`,
  description = site.descripcion,
  imagen = logo,
  imagenAlt = `Logo de ${site.nombre}`,
  tipo = 'website',
  precio,
  noindex = false,
} = Astro.props;

// Favicon e ícono de iOS se generan desde el logo; la imagen para compartir en redes,
// desde la foto del producto o el logo. Cuadrada en JPG (Facebook la muestra bien), de hasta
// 1080 px y sin agrandar fotos más chicas, así las medidas declaradas son las reales.
const ladoOg = Math.min(1080, imagen.width, imagen.height);
const [favicon, appleIcon, ogImage] = await Promise.all([
  getImage({ src: logo, width: 32, height: 32, format: 'png' }),
  getImage({ src: logo, width: 180, height: 180, format: 'png' }),
  getImage({ src: imagen, width: ladoOg, height: ladoOg, fit: 'cover', format: 'jpg' }),
]);

const canonical = new URL(Astro.url.pathname, Astro.site);
// Facebook y WhatsApp necesitan la URL absoluta de la imagen
const ogImageUrl = new URL(ogImage.src, Astro.site);

// Datos estructurados: ayudan a Google a mostrar el negocio con horario y teléfono.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ShoeStore',
  name: site.nombre,
  description: site.descripcion,
  url: Astro.site?.href,
  image: ogImageUrl.href,
  telephone: `+${site.whatsapp.numero}`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Palpalá',
    addressRegion: 'Jujuy',
    addressCountry: 'AR',
  },
  areaServed: 'Palpalá, Jujuy',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '13:00',
    },
  ],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/png" sizes="32x32" href={favicon.src} />
    <link rel="apple-touch-icon" href={appleIcon.src} />
    <meta name="theme-color" content="#0d47a1" />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ladoOg)} />
    <meta property="og:image:height" content={String(ladoOg)} />
    <meta property="og:image:alt" content={imagenAlt} />
    {tipo === 'product' && precio !== undefined && (
      <>
        <meta property="product:price:amount" content={String(precio)} />
        <meta property="product:price:currency" content="ARS" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imagenAlt} />

    <Font cssVariable="--font-inter" preload={[{ weight: 400 }, { weight: 600 }]} />
    <Font cssVariable="--font-poppins" preload={[{ weight: 700 }]} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
