---
import { getCatalogo, productosPorPagina } from '../lib/catalogo';
import { whatsappUrl } from '../lib/format';
import Boton from './Boton.astro';
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';

const { categorias, productos } = await getCatalogo();

const filtros = [
  { valor: 'todos', nombre: 'Todos' },
  ...categorias.map((c) => ({ valor: c.id, nombre: c.nombre })),
];
---

<section id="catalogo" class="bg-white">
  <div class="container-page py-14 md:py-18 lg:py-22">
    <h2 class="mb-2 font-display text-2xl leading-tight font-bold md:text-3xl">Nuestro catálogo</h2>
    <p class="mb-5 max-w-[560px] text-base leading-normal text-pretty text-muted">
      Fotos reales de cada par. Consultá stock y talles por WhatsApp.
    </p>

    <!-- Filtro: sin JavaScript se ven todos los productos -->
    <div
      role="group"
      aria-label="Filtrar por categoría"
      class="-mx-4 mb-6 flex gap-2 overflow-x-auto px-4 pt-1 pb-2.5 [scrollbar-width:none] md:-mx-8 md:px-8 lg:-mx-10 lg:px-10"
    >
      {filtros.map((f) => (
        <button
          type="button"
          data-filtro={f.valor}
          aria-pressed={f.valor === 'todos' ? 'true' : 'false'}
          class="group relative min-h-11 shrink-0 cursor-pointer rounded-full bg-celeste-200 px-[18px] text-[15px] font-semibold text-navy transition-colors duration-200 hover:brightness-95 active:scale-[0.96] aria-pressed:bg-brand aria-pressed:text-white"
        >
          {f.nombre}
          <span
            aria-hidden="true"
            class="absolute bottom-1.5 left-1/2 size-1.5 -translate-x-1/2 rounded-full bg-lila-400 opacity-0 group-aria-pressed:opacity-100"
          />
        </button>
      ))}
    </div>

    <p data-catalogo-estado aria-live="polite" class="sr-only"></p>

    <ul
      data-catalogo-grilla
      data-por-pagina={productosPorPagina}
      class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:grid-cols-4"
    >
      {productos.map((p) => (
        <li data-categoria={p.categoria.id}>
          <ProductCard producto={p} />
        </li>
      ))}
    </ul>

    <!-- Paginado: lo arma el script. Sin JavaScript se ven todos los productos y esto no aparece -->
    <nav
      data-catalogo-paginas
      aria-label="Páginas del catálogo"
      hidden
      class="mt-8 flex flex-col items-center gap-3"
    >
      <p data-catalogo-rango class="text-sm text-muted"></p>
      <ul data-catalogo-botones class="flex flex-wrap items-center justify-center gap-1.5"></ul>
    </nav>

    <div
      data-catalogo-vacio
      hidden
      class="flex flex-col items-center gap-4 rounded-2xl border border-dashed border-celeste-200 bg-celeste-50 px-5 py-12 text-center"
    >
      <span class="flex size-16 items-center justify-center rounded-full bg-lila-100 text-brand">
        <Icon name="zapato" size={32} strokeWidth={1.5} />
      </span>
      <p class="max-w-[380px] text-base leading-normal text-pretty">
        No hay modelos en esta categoría por ahora. Escribinos y te contamos qué llega.
      </p>
      <Boton href={whatsappUrl()} whatsapp>
        Escribinos
      </Boton>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-lila-100 p-5">
      <p class="max-w-[520px] text-base leading-normal font-medium">
        ¿No encontrás tu talle o modelo? Tenemos más variedad. Escribinos.
      </p>
      <Boton href={whatsappUrl()} whatsapp>
        Escribir por WhatsApp
      </Boton>
    </div>
  </div>
</section>

<script>
  import { icons } from '../lib/icons';

  // Filtro por categoría + paginado de a `data-por-pagina` productos.
  const seccion = document.querySelector<HTMLElement>('#catalogo');
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-categoria]')];
  const grilla = document.querySelector<HTMLElement>('[data-catalogo-grilla]');
  const vacio = document.querySelector<HTMLElement>('[data-catalogo-vacio]');
  const estado = document.querySelector<HTMLElement>('[data-catalogo-estado]');
  const nav = document.querySelector<HTMLElement>('[data-catalogo-paginas]');
  const rango = document.querySelector<HTMLElement>('[data-catalogo-rango]');
  const lista = document.querySelector<HTMLElement>('[data-catalogo-botones]');
  const porPagina = Number(grilla?.dataset.porPagina) || 12;

  let filtro = 'todos';
  let pagina = 1;

  const flecha = (nombre: 'anterior' | 'siguiente') =>
    `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[nombre]}</svg>`;

  // En celular entran menos botones en una fila
  const ancho = window.matchMedia('(min-width: 640px)');

  /**
   * Con muchas páginas no se muestran todas: en celular "1 … 4 … 10",
   * en pantallas más anchas "1 … 3 4 5 … 10".
   */
  function numeros(actual: number, total: number): (number | '…')[] {
    const vecinas = ancho.matches ? 1 : 0;
    if (total <= (ancho.matches ? 7 : 5)) return Array.from({ length: total }, (_, i) => i + 1);
    const cerca: number[] = [];
    for (let n = actual - vecinas; n <= actual + vecinas; n++) {
      if (n > 1 && n < total) cerca.push(n);
    }
    // En la primera o la última página no hay "cerca": queda "1 … 10"
    if (cerca.length === 0) return [1, '…', total];
    const resultado: (number | '…')[] = [1];
    if (cerca[0]! > 2) resultado.push('…');
    resultado.push(...cerca);
    if (cerca.at(-1)! < total - 1) resultado.push('…');
    resultado.push(total);
    return resultado;
  }

  const claseBoton =
    'flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1 rounded-xl px-3 text-[15px] font-semibold transition-colors duration-200 disabled:cursor-default disabled:opacity-40';

  function boton(
    texto: string,
    destino: number,
    opciones: { etiqueta?: string; actual?: boolean; deshabilitado?: boolean } = {},
  ) {
    const b = document.createElement('button');
    b.type = 'button';
    b.innerHTML = texto;
    b.dataset.pagina = String(destino);
    b.className = `${claseBoton} ${
      opciones.actual
        ? 'bg-brand text-white'
        : 'bg-celeste-100 text-navy hover:bg-celeste-200 disabled:hover:bg-celeste-100'
    }`;
    if (opciones.etiqueta) b.setAttribute('aria-label', opciones.etiqueta);
    if (opciones.actual) b.setAttribute('aria-current', 'page');
    b.disabled = opciones.deshabilitado ?? false;
    const li = document.createElement('li');
    li.append(b);
    return li;
  }

  function dibujarPaginas(total: number, cantidad: number) {
    if (!nav || !lista || !rango) return;
    nav.hidden = total <= 1;
    if (total <= 1) return;

    const desde = (pagina - 1) * porPagina + 1;
    const hasta = Math.min(pagina * porPagina, cantidad);
    rango.textContent = `Mostrando ${desde}–${hasta} de ${cantidad} modelos`;

    lista.replaceChildren(
      boton(`${flecha('anterior')}<span class="hidden sm:inline">Anterior</span>`, pagina - 1, {
        etiqueta: 'Página anterior',
        deshabilitado: pagina === 1,
      }),
      ...numeros(pagina, total).map((n) => {
        if (n === '…') {
          const li = document.createElement('li');
          li.textContent = '…';
          li.className = 'px-1 text-muted';
          li.setAttribute('aria-hidden', 'true');
          return li;
        }
        return boton(String(n), n, { etiqueta: `Página ${n}`, actual: n === pagina });
      }),
      boton(`<span class="hidden sm:inline">Siguiente</span>${flecha('siguiente')}`, pagina + 1, {
        etiqueta: 'Página siguiente',
        deshabilitado: pagina === total,
      }),
    );
  }

  function mostrar() {
    const coinciden = items.filter(
      (item) => filtro === 'todos' || item.dataset.categoria === filtro,
    );
    const total = Math.max(1, Math.ceil(coinciden.length / porPagina));
    pagina = Math.min(Math.max(pagina, 1), total);

    const inicio = (pagina - 1) * porPagina;
    const enPagina = new Set(coinciden.slice(inicio, inicio + porPagina));
    items.forEach((item) => (item.hidden = !enPagina.has(item)));

    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === filtro)));
    if (grilla) grilla.hidden = coinciden.length === 0;
    if (vacio) vacio.hidden = coinciden.length !== 0;
    dibujarPaginas(total, coinciden.length);

    // Lo anuncia el lector de pantalla
    if (estado) {
      const modelos = `${coinciden.length} ${coinciden.length === 1 ? 'modelo' : 'modelos'}`;
      estado.textContent = total > 1 ? `${modelos}, página ${pagina} de ${total}` : modelos;
    }
  }

  botones.forEach((b) =>
    b.addEventListener('click', () => {
      filtro = b.dataset.filtro ?? 'todos';
      pagina = 1;
      mostrar();
    }),
  );

  lista?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-pagina]');
    if (!b || b.disabled) return;
    pagina = Number(b.dataset.pagina);
    mostrar();
    // Vuelve arriba del catálogo para empezar a ver la página nueva desde el principio
    seccion?.scrollIntoView({ block: 'start' });
    // Los botones se vuelven a dibujar: el foco pasa al primer producto de la página nueva
    grilla?.querySelector<HTMLElement>('li:not([hidden]) h3 a')?.focus({ preventScroll: true });
  });

  ancho.addEventListener('change', mostrar);
  mostrar();
</script>
