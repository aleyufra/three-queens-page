---
import { publicos, type Producto } from '../lib/catalogo';
import { formatPrecio, whatsappProductoUrl } from '../lib/format';
import Boton from './Boton.astro';
import FotosProducto from './FotosProducto.astro';

interface Props {
  producto: Producto;
}

const { producto: p } = Astro.props;

const etiqueta = p.publico ? `${p.categoria.nombre} · ${publicos[p.publico]}` : p.categoria.nombre;
const precioAnterior = p.precioAnterior && p.precioAnterior > p.precio ? p.precioAnterior : null;
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white shadow-card transition-[box-shadow,translate] duration-200 hover:-translate-y-0.5 hover:shadow-card-hover">
  <FotosProducto
    fotos={p.fotos}
    nombre={p.nombre}
    widths={[240, 360, 560]}
    sizes="(min-width: 1024px) 280px, (min-width: 768px) 33vw, 50vw"
  />

  <div class="flex flex-1 flex-col gap-2 p-3 md:p-4">
    <div class="flex flex-wrap gap-1">
      {p.destacado && (
        <span class="rounded-full bg-brand px-2.5 py-0.5 text-xs font-semibold text-white">
          Destacado
        </span>
      )}
      <span class="rounded-full bg-lila-100 px-2.5 py-0.5 text-xs font-semibold">{etiqueta}</span>
    </div>
    <h3 class="line-clamp-2 font-display text-[15px] leading-snug font-semibold md:text-[17px]">
      <a href={`/producto/${p.id}/`} class="text-navy no-underline hover:underline">
        {p.nombre}
      </a>
    </h3>
    {p.descripcion && (
      <p class="line-clamp-2 text-[13px] leading-snug text-muted">{p.descripcion}</p>
    )}
    <p class="flex flex-wrap items-baseline gap-x-2">
      <span class="text-xl leading-tight font-semibold md:text-[22px]">
        {formatPrecio(p.precio)}
      </span>
      {precioAnterior && (
        <s class="text-sm text-muted">
          <span class="sr-only">Antes:</span>
          {formatPrecio(precioAnterior)}
        </s>
      )}
    </p>

    <ul aria-label="Talles disponibles" class="flex flex-wrap gap-1">
      {p.talles.map(({ talle }) => (
        <li class="min-w-[26px] rounded-md border border-celeste-200 bg-celeste-50 px-1.5 py-0.5 text-center text-xs font-medium">
          {talle}
        </li>
      ))}
    </ul>
    <!-- <p class="flex items-center gap-1.5 text-[13px] font-medium">
      <Icon name="horma" size={16} class="text-brand" />
      Horma {p.horma}
    </p> -->

    <Boton
      href={whatsappProductoUrl(p)}
      whatsapp
      class="mt-auto px-3"
      aria-label={`Lo quiero: ${p.nombre}`}
    >
      Lo quiero
    </Boton>
  </div>
</article>
